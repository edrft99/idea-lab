# Server only. Never use NEXT_PUBLIC_ or VITE_ prefixes for credentials.
NOTION_TOKEN=
NOTION_API_VERSION=2026-03-11
IDEA_LAB_OWNER_USER_ID=
IDEA_LAB_OWNER_EMAIL=
NOTION_HUB_URL=
NOTION_IDEAS_URL=
NOTION_SOURCES_URL=
NOTION_EVALUATIONS_URL=
NOTION_REVIEWS_URL=
NOTION_IDEAS_DATA_SOURCE_ID=
NOTION_SOURCES_DATA_SOURCE_ID=
NOTION_EVALUATIONS_DATA_SOURCE_ID=
NOTION_REVIEWS_DATA_SOURCE_ID=

# Optional AI assessment. Leave unset to keep model requests disabled.
IDEA_LAB_AI_PROVIDER=
IDEA_LAB_AI_ENDPOINT=
IDEA_LAB_AI_DEPLOYMENT=
IDEA_LAB_AI_API_KEY=
# Describe the actual provider retention/monitoring policy before enabling.
IDEA_LAB_AI_RETENTION_NOTICE=
IDEA_LAB_AI_MAX_OUTPUT_TOKENS=4096
IDEA_LAB_AI_TIMEOUT_MS=45000
IDEA_LAB_AI_REQUESTS_PER_HOUR=5

# Optional semantic search; separate embedding deployment/key, disabled while unset.
IDEA_LAB_EMBEDDING_ENDPOINT=
IDEA_LAB_EMBEDDING_DEPLOYMENT=
IDEA_LAB_EMBEDDING_API_KEY=
IDEA_LAB_EMBEDDING_DIMENSIONS=
# Operator-pinned deployment/model version label; change when weights change.
IDEA_LAB_EMBEDDING_VERSION=
# Set true only for deployments that support the dimensions request parameter.
IDEA_LAB_EMBEDDING_REQUEST_DIMENSIONS=false
IDEA_LAB_EMBEDDING_RETENTION_NOTICE=
IDEA_LAB_EMBEDDING_CACHE_SECONDS=604800
IDEA_LAB_EMBEDDING_TIMEOUT_MS=45000
# Embedding/assessment/extraction requests share IDEA_LAB_AI_REQUESTS_PER_HOUR.

# Optional GPT seat for the idea roundtable. Unset leaves GPT disconnected.
# Use openai-responses for direct OpenAI, or azure-openai-responses with
# the existing IDEA_LAB_AI_* Azure configuration above.
IDEA_LAB_GPT_PROVIDER=
IDEA_LAB_GPT_MODEL=
IDEA_LAB_GPT_API_KEY=
IDEA_LAB_GPT_RETENTION_NOTICE=
IDEA_LAB_GPT_MAX_OUTPUT_TOKENS=4096
IDEA_LAB_GPT_TIMEOUT_MS=45000
# Shares IDEA_LAB_AI_REQUESTS_PER_HOUR with the other AI features.
